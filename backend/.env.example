# Exemple de configuration du backend. Copiez ces variables dans votre
# environnement (ou le tableau de bord Render) ; ne commitez jamais les
# vraies valeurs.

# `development` autorise les sites en http et une clé JWT par défaut.
# Sur Render, la valeur par défaut est `production`.
APP_ENV=development

# PostgreSQL (Neon). Les deux formes sont acceptées :
#   postgresql://…?sslmode=require  ou  postgresql+asyncpg://…
# Sans cette variable : stockage local (SQLite + disque) dans data/.
DATABASE_URL=

# Signature des jetons de session : obligatoire hors développement.
# Générez-la avec : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
# Jeton d'accès court ; la session est prolongée par le jeton de
# renouvellement (rotation à chaque usage).
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Connexion Google : identifiant(s) client OAuth acceptés comme audience des
# ID tokens, séparés par des virgules. Mettre l'ID du client « Application
# Web » (utilisé par la PWA, et comme serverClientId sur Android).
GOOGLE_CLIENT_ID=
# Inutile pour la vérification des ID tokens (clés publiques de Google) ;
# réservé à un futur échange de code côté serveur. Jamais dans Flutter.
GOOGLE_CLIENT_SECRET=

# Connexion Facebook (application Meta). Le secret reste sur le serveur,
# jamais dans Flutter.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Base des adresses encodées dans les QR Codes (`/q/{slug}`, fichiers).
# Par défaut : QR_STUDIO_PUBLIC_URL, puis RENDER_EXTERNAL_URL.
PUBLIC_BASE_URL=https://qrstudio.app

# Origines web autorisées (PWA), séparées par des virgules.
QR_STUDIO_CORS_ORIGINS=

# Espace total autorisé pour les fichiers (MB).
QR_STUDIO_MAX_STORAGE_MB=400
